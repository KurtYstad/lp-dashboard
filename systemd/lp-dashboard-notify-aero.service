[Unit]
Description=LP dashboard Aerodrome notifier
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_DIR@/notify/aero
ExecStart=@PROJECT_DIR@/.venv/bin/python -u @PROJECT_DIR@/notify/aero/aero.py
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
