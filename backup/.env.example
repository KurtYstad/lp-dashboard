# MariaDB connection
DB_USER=replace_with_database_user
DB_PASSWORD=replace_with_database_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_with_database_name

# FTP destination
FTP_HOST=replace_with_ftp_hostname
FTP_PORT=21
FTP_USER=replace_with_ftp_user
FTP_PASSWORD=replace_with_ftp_password
FTP_REMOTE_DIR=backups

# Set to 1 to require explicit FTPS; 0 uses plain FTP.
FTP_TLS=0
